# 실제 값은 .env.local에만 넣으세요 (git 커밋 금지!)

# Upstage Solar Pro 2 — https://console.upstage.ai (up_ 로 시작)
UPSTAGE_API_KEY=

# SKT A.X-K1 — https://portal.adot.ai (awf_ 로 시작) ⚠️ 팀당 1키 · RPS 3 공유
SKT_AX_API_KEY=

# LG K-EXAONE — Friendli 토큰(flp_) + Dedicated Endpoint ID
FRIENDLI_TOKEN=
FRIENDLI_KEXAONE_ENDPOINT_ID=

# KT 믿:음 2.0 — Friendli (토큰·Endpoint 별도)
FRIENDLI_MIDM_TOKEN=
FRIENDLI_MIDM_ENDPOINT_ID=

# NC VARCO — 챗 API 스펙 확보 전까지 미사용
VARCO_API_KEY=
VARCO_WORKSPACE_ID=
