{
  "name": "madi-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MADI — 픽셀 강아지 데스크톱 AI 도우미 (Windows XP 검색 도우미 스타일)",
  "main": "out/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5",
    "vite": "^5.4.11"
  }
}
